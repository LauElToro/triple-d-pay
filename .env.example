# URL del backend Set-Api (build time).
# Vercel: ver VERCEL.env.template.md
# Local: http://localhost:4000
# Prod:  https://set-api-backend.vercel.app
VITE_API_URL="http://localhost:4000"

# Opcional — Google Sign-In. Dejar vacío si solo usás email/contraseña.
# Mismo Client ID en Backend → GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=""
