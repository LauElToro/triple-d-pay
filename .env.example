# URL del backend Set-Api (API). Se inyecta en build time.
# Local: http://localhost:4000
# Prod:  https://set-api-backend.vercel.app
VITE_API_URL="http://localhost:4000"

# Google Sign-In Client ID (público, GIS). Mismo valor que GOOGLE_CLIENT_ID en Backend.
# Vacío = botón de Google deshabilitado.
VITE_GOOGLE_CLIENT_ID=""
